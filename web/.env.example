# Copy this file to ".env" and fill it in. Everything is optional for a quick demo.

PORT=3000
SESSION_SECRET=change-me-to-any-long-random-text

# --- E-mail for the "Forgot password" code (Gmail example) ---
# 1) Turn on 2-Step Verification in your Google account
# 2) Create an "App password" at https://myaccount.google.com/apppasswords
# 3) Put your Gmail address and that 16-letter app password below
# If these two are left empty, the code is printed in the VS Code terminal instead.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Speech model: whisper-tiny.en is fastest, whisper-base.en is more accurate ---
WHISPER_MODEL=Xenova/whisper-tiny.en
MAX_MINUTES=120
